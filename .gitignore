# Dart / Flutter
.dart_tool/
.packages
build/
coverage/
.flutter-plugins
.flutter-plugins-dependencies

# Melos (generated during bootstrap)
pubspec_overrides.yaml
.melos_tool/

# IDE
.idea/
*.iml
.vscode/

# Android signing (never commit the keystore)
*.jks
*.keystore
**/key.properties

# iOS signing
*.p12
*.mobileprovision
*.certSigningRequest

# Supabase local dev
supabase/.temp/
supabase/.branches/
supabase/.env

# Secrets / env
.env
.env.*
!.env.example

# Compile-time config for --dart-define-from-file: real values stay local,
# the *.example.json templates are committed
env/*.json
!env/*.example.json

# OS / WSL artifacts
.DS_Store
*:Zone.Identifier

# Screenshot captures from test/screenshots_test.dart. Generated on demand and
# rewritten wholesale on every recapture; regenerate rather than committing:
#   flutter test test/screenshots_test.dart --tags screenshots --run-skipped --update-goldens
apps/dietitian_panel/test/goldens/
